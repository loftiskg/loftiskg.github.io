---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('writing', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true
	);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<Layout title={`${post.data.title} — Kevin Loftis`} description={post.data.description}>
	<main>
		<nav><a class="link back" href="/writing/">Writing</a></nav>

		<article>
			<header>
				<h1>{post.data.title}</h1>
				<time datetime={post.data.pubDate.toISOString()}>
					{dateFormat.format(post.data.pubDate)}
				</time>
			</header>
			<Content />
		</article>
	</main>
</Layout>

<style>
	main {
		max-width: 42rem;
		padding: clamp(3rem, 10vh, 5rem) var(--gutter) clamp(5rem, 14vh, 9rem);
	}

	nav {
		margin-bottom: clamp(3rem, 8vw, 4.5rem);
	}

	.back {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--muted);
	}

	.link {
		font-family: var(--font-mono), ui-monospace, monospace;
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 calc(100% - 0.05em);
		background-size: 0% 1px;
		transition:
			background-size 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
			color 0.2s ease;
	}

	.link:hover,
	.link:focus-visible {
		color: var(--accent);
		background-size: 100% 1px;
	}

	header {
		margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
	}

	h1 {
		margin: 0 0 0.7rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-weight: 500;
		font-size: clamp(1.9rem, 6vw, 2.75rem);
		line-height: 1.05;
		letter-spacing: -0.045em;
		text-indent: -0.05em;
		text-wrap: balance;
	}

	time {
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	/* Prose. Body serif is inherited from the layout. */
	article {
		font-size: 1.075rem;
		line-height: 1.7;
	}

	article :global(h2) {
		margin: clamp(2.5rem, 6vw, 3.25rem) 0 0.9rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-weight: 500;
		font-size: 1.1rem;
		letter-spacing: -0.02em;
	}

	article :global(h3) {
		margin: 2rem 0 0.6rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		color: var(--muted);
	}

	article :global(p),
	article :global(li) {
		text-wrap: pretty;
	}

	article :global(a) {
		color: var(--accent);
		text-underline-offset: 0.15em;
		text-decoration-thickness: 1px;
	}

	article :global(strong) {
		font-weight: 600;
	}

	article :global(code) {
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.83em;
		background: color-mix(in srgb, var(--faint) 55%, transparent);
		padding: 0.12em 0.36em;
		border-radius: 2px;
	}

	article :global(pre) {
		margin: 1.6rem 0;
		padding: 1.1rem 1.25rem;
		border-radius: 4px;
		overflow-x: auto;
		font-size: 0.8rem;
		line-height: 1.6;
	}

	article :global(pre code) {
		background: none;
		padding: 0;
		font-size: inherit;
	}

	article :global(blockquote) {
		margin: 1.75rem 0;
		padding-left: 1.1rem;
		border-left: 2px solid var(--faint);
		color: var(--muted);
	}

	article :global(hr) {
		margin: 3rem 0;
		border: 0;
		border-top: 1px solid var(--faint);
	}
</style>
