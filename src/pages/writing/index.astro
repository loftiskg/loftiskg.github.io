---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Drafts are visible locally but never published.
const posts = (
	await getCollection('writing', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormat = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<Layout title="Writing — Kevin Loftis" description="Posts by Kevin Loftis.">
	<main>
		<nav><a class="link back" href="/">Kevin Loftis</a></nav>

		<h1>Writing</h1>

		<ul class="posts">
			{
				posts.map((post) => (
					<li>
						<a class="link title" href={`/writing/${post.id}/`}>
							{post.data.title}
						</a>
						{post.data.draft && <span class="draft">draft</span>}
						<p>{post.data.description}</p>
						<time datetime={post.data.pubDate.toISOString()}>
							{dateFormat.format(post.data.pubDate)}
						</time>
					</li>
				))
			}
		</ul>

		{posts.length === 0 && <p class="empty">Nothing here yet.</p>}
	</main>
</Layout>

<style>
	main {
		max-width: 46rem;
		padding: clamp(3rem, 10vh, 5rem) var(--gutter) clamp(4rem, 12vh, 8rem);
	}

	nav {
		margin-bottom: clamp(3rem, 8vw, 4.5rem);
	}

	.back {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--muted);
	}

	h1 {
		margin: 0 0 clamp(2.5rem, 7vw, 4rem);
		font-family: var(--font-mono), ui-monospace, monospace;
		font-weight: 500;
		font-size: clamp(2rem, 7vw, 3rem);
		line-height: 1;
		letter-spacing: -0.045em;
		text-indent: -0.05em;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(2.25rem, 5vw, 3rem);
	}

	.title {
		font-size: 1.15rem;
	}

	.posts p {
		max-width: var(--measure);
		margin: 0.5rem 0 0.6rem;
		color: var(--muted);
	}

	time,
	.empty {
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	.draft {
		margin-left: 0.6rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--accent);
		vertical-align: 0.15em;
	}

	.link {
		font-family: var(--font-mono), ui-monospace, monospace;
		text-decoration: none;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-repeat: no-repeat;
		background-position: 0 calc(100% - 0.05em);
		background-size: 0% 1px;
		transition:
			background-size 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
			color 0.2s ease;
	}

	.link:hover,
	.link:focus-visible {
		color: var(--accent);
		background-size: 100% 1px;
	}
</style>
